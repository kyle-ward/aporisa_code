# Aporisa Code (frontend) deployment differences only (AGENTS.md). Copy to
# aporisa_code/.env and edit. Read by the CLI (npm run aporisa) and the user-run tools
# (tools/conformance.ts, tools/agent-tasks.ts); never bundled into the app's renderer.
# Variables set in the environment take precedence over this file.

# The backend's API root, including /v1. Local Studio: http://127.0.0.1:18080/v1.
# From the Air: the Cloudflare Tunnel hostname of the Studio backend.
APORISA_BASE_URL=http://127.0.0.1:18080/v1

# The bearer key of the backend (APORISA_API_KEY in backend/.env).
APORISA_API_KEY=

# Public model alias (backend configs/models.py POINTERS). Empty: the first listed model.
APORISA_MODEL=aporisa-local-v0

# OpenRouter key for the compat driver (F5). Development only; send test content only.
OPENROUTER_API_KEY=
