# Backend deployment differences only (AGENTS.md). Copy to backend/.env and edit.
# Public model aliases live in backend/src/aporisa_backend/configs/models.py (POINTERS),
# never here. Unknown keys are rejected.

# Bearer key clients must send. Use a long random printable ASCII secret, for example:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
APORISA_API_KEY=REPLACE_WITH_A_RANDOM_SECRET

# The only port the backend listens on (127.0.0.1). Default 18080.
APORISA_BACKEND_PORT=18080
